# ===============================================
# Smart Parking AI - Backend Environment Variables
# ===============================================

# Server Port (Render sets this automatically; defaults to 5000)
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Replace <username>, <password>, and cluster domain with your Atlas values
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart_parking?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Allowed Frontend Client URL (e.g., your Vercel deployment URL)
# Multiple URLs can be separated by commas
CLIENT_URL=https://next-park-ai.vercel.app,http://localhost:3000

# Razorpay Credentials (Test or Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Aliases for Cloudinary backwards compatibility
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret
