# ===============================================
# Smart Parking AI - Frontend Environment Variables
# ===============================================

# Backend Express API Base URL (with /api suffix)
REACT_APP_API_URL=https://next-park-ai-backend.onrender.com/api

# Backend Server Root URL (for Socket.IO and tickets)
REACT_APP_BACKEND_URL=https://next-park-ai-backend.onrender.com

# Socket.IO WebSocket Server URL
REACT_APP_SOCKET_URL=https://next-park-ai-backend.onrender.com

# Razorpay Key ID (public test or live key, must match backend RAZORPAY_KEY_ID)
REACT_APP_RAZORPAY_KEY_ID=rzp_test_your_key_id
